# ---------------------------------------------------------------------------
# AI Interpreter - secrets template
#
# Copy this file to ".env" and fill in values you actually need.
# ".env" is git-ignored and must NEVER be committed.
#
# IMPORTANT: this file is for SECRETS ONLY (tokens, API keys).
# All normal configuration lives in config/default.yaml, which is
# human-readable, commented, and safe to commit.
# ---------------------------------------------------------------------------

# Hugging Face access token.
# Only required for gated model repositories. Most models we use are public,
# so you can leave this empty for now.
AI_INTERPRETER_HF_TOKEN=

# NVIDIA NIM API key.
# Only required if you explicitly enable the cloud translation provider.
# Leave empty to stay fully local (the default and recommended mode).
AI_INTERPRETER_NVIDIA_NIM_API_KEY=
