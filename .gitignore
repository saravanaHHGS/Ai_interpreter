# ---------------------------------------------------------------------------
# AI Interpreter - version control exclusions
# ---------------------------------------------------------------------------

# Virtual environment
.venv/
venv/
env/

# Python bytecode / build artefacts
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
*.spec

# Tooling caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
coverage.xml
htmlcov/

# Secrets - NEVER commit
.env
.env.local

# Runtime data (regenerated, large, or private)
logs/
models/
recordings/
*.log

# Windows / IDE noise
Thumbs.db
desktop.ini
.vscode/settings.json
.idea/
